# Copy this to .env and fill in real values

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/zmanim"

# Express session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-random-hex-string"

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Email allowlist — comma-separated list of Google accounts permitted to log in.
# Leave empty to allow any Google account.
# Example: ALLOWED_EMAILS="alice@gmail.com,bob@school.edu"
ALLOWED_EMAILS=""

# Legacy domain restriction — restrict to a specific Google Workspace domain.
# Leave empty unless you want to restrict by domain instead of individual emails.
ALLOWED_EMAIL_DOMAIN=""

# URL of the React client (for CORS + OAuth redirects)
CLIENT_URL="http://localhost:5173"

PORT=3001
NODE_ENV=development
