// Zmanim — Prisma Schema
// See implementation-plan.md §2 for full rationale on every model.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
}

enum Day {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
}

enum RoomCapacity {
  STANDARD
  LARGE
}

enum LessonType {
  REGULAR        // one class, one teacher, one room
  SHARED         // two classes, same room, same time, one teacher
  PARALLEL       // two classes, each gets its own teacher+room simultaneously; one lesson record, two LessonTeacher entries
  MATH_GROUP     // cross-class math level group (3/4/5 pt bagrut)
  ENGLISH_GROUP  // cross-class English level group (same structure as MATH_GROUP)
  MULTI_TEACHER  // two classes, one room, multiple teachers; one lesson record, multiple LessonTeacher entries
}

enum MathLevel {
  THREE_POINT
  FOUR_POINT
  FIVE_POINT
}

enum ScheduleState {
  DRAFT
  PUBLISHED
}

enum RestrictionTier {
  /// Hard physical impossibilities — generated by code, never stored on Restriction rows.
  /// Present in the enum so Prisma can store it on Override records if ever needed.
  INVARIANT
  NON_NEGOTIABLE
  IMPORTANT
  PREFERRED
  FLEXIBLE
}

enum RestrictionType {
  // Category A — Teacher availability
  TEACHER_UNAVAILABLE_DAY           // params: { day }
  TEACHER_UNAVAILABLE_SLOT          // params: { slot }
  TEACHER_UNAVAILABLE_DAY_SLOT      // params: { day, slot }
  TEACHER_MAX_DAYS_PER_WEEK         // params: { max }
  TEACHER_MIN_DAYS_PER_WEEK         // params: { min }
  TEACHER_MAX_LESSONS_PER_DAY       // params: { max }
  TEACHER_MAX_CONSECUTIVE           // params: { max }
  TEACHER_MAX_WINDOW                // params: { maxSlots }
  TEACHER_NO_SINGLE_LESSON_DAY      // params: {}

  // Category B — Class/grade quality
  CLASS_NO_WINDOW                   // params: {}
  CLASS_MINIMIZE_WINDOWS            // params: {}
  CLASS_NO_SUBJECT_TWICE_PER_DAY    // params: {}
  CLASS_ARTS_BALANCE                // params: {}
  CLASS_NO_SUBJECT_EDGE_MULTIPLE_DAYS // params: { maxDays }

  // Category C — Room
  ROOM_LARGE_FOR_SHARED             // params: {}

  // Category E — Lesson preferences
  LESSON_AVOID_DAY                  // params: { day }
  LESSON_AVOID_SLOT                 // params: { slot }
  LESSON_PREFER_MORNING             // params: {}
  LESSON_PREFER_AFTERNOON           // params: {}
  LESSON_GRADE_SYNC                 // params: {}
}

// ─── Models ──────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  googleId  String   @unique
  picture   String?
  role      Role     @default(ADMIN)
  // For TEACHER role: links this login to a Teacher entity
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One record only — the school's day structure.
/// Recesses stored as JSON: [{ afterSlot: 1, durationMinutes: 15 }, ...]
model SchoolConfig {
  id             String   @id @default(uuid())
  dayStartTime   String   // "08:00"
  lessonDuration Int      // minutes (75)
  slotsPerDay    Int      // 4
  recesses       Json     // Recess[]
  workDays       Day[]
}

model Subject {
  id                String   @id @default(uuid())
  name              String   // Hebrew
  isArts            Boolean  @default(false)
  color             String   // hex from design palette
  // If set, lessons of this subject MUST be placed in this room (D6 invariant)
  specializedRoomId String?
  specializedRoom   Room?    @relation("SpecializedSubjects", fields: [specializedRoomId], references: [id])
  lessons           Lesson[]
  // Back-relation for the Teacher ↔ Subject many-to-many
  teachers          Teacher[] @relation("TeacherSubjects")
  restrictions      Restriction[]
  createdAt         DateTime @default(now())
}

model Room {
  id             String       @id @default(uuid())
  name           String       // Hebrew
  capacity       RoomCapacity @default(STANDARD)
  // Subjects that have this room as their specialized room
  specializedFor Subject[]    @relation("SpecializedSubjects")
  entries        ScheduleEntry[] @relation("EntryRoom1")
  entries2       ScheduleEntry[] @relation("EntryRoom2")
  createdAt      DateTime     @default(now())
}

model Teacher {
  id             String          @id @default(uuid())
  name           String          // Hebrew
  subjects       Subject[]       @relation("TeacherSubjects")
  lessons        Lesson[]
  lessonTeachers LessonTeacher[] @relation("LessonTeachers")
  restrictions   Restriction[]
  users          User[]          // login account(s) for this teacher
  createdAt      DateTime        @default(now())
}

model Grade {
  id           String        @id @default(uuid())
  number       Int           @unique // 7–12
  classes      Class[]
  lessons      Lesson[]      // MATH_GROUP / ENGLISH_GROUP lessons belong to a grade
  restrictions Restriction[]
}

model Class {
  id             String          @id @default(uuid())
  gradeId        String
  grade          Grade           @relation(fields: [gradeId], references: [id])
  section        String          // "A" | "B"
  lessons        Lesson[]        @relation("ClassLessons")
  lessonTeachers LessonTeacher[] @relation("LessonTeacherClass")
  restrictions   Restriction[]

  @@unique([gradeId, section])
}

model Lesson {
  id             String          @id @default(uuid())
  type           LessonType
  subjectId      String
  subject        Subject         @relation(fields: [subjectId], references: [id])
  // null for PARALLEL and MULTI_TEACHER — those use LessonTeacher entries instead
  teacherId      String?
  teacher        Teacher?        @relation(fields: [teacherId], references: [id])
  hoursPerWeek   Int
  // For REGULAR: one class. For SHARED/PARALLEL/MULTI_TEACHER: two classes (same grade).
  // For MATH_GROUP / ENGLISH_GROUP: both classes of the grade (students redistributed into level groups).
  classes        Class[]         @relation("ClassLessons")
  // Required for MATH_GROUP / ENGLISH_GROUP: the grade these level groups belong to
  gradeId        String?
  grade          Grade?          @relation(fields: [gradeId], references: [id])
  mathLevel      MathLevel?      // THREE_POINT | FOUR_POINT | FIVE_POINT (MATH_GROUP only)
  englishLevel   MathLevel?      // reuses same 3/4/5 pt enum (ENGLISH_GROUP only)
  // PARALLEL: two entries, one per class, each with a classId
  // MULTI_TEACHER: multiple entries, each with classId = null (shared room)
  lessonTeachers LessonTeacher[]
  entries        ScheduleEntry[]
  restrictions   Restriction[]
  createdAt      DateTime        @default(now())
}

// Join table for PARALLEL and MULTI_TEACHER lesson types.
// PARALLEL:     two rows — { lessonId, teacherId=A, classId=classA }, { lessonId, teacherId=B, classId=classB }
// MULTI_TEACHER: N rows — { lessonId, teacherId=A, classId=null }, ...
model LessonTeacher {
  lessonId  String
  teacherId String
  classId   String?  // PARALLEL: which class this teacher covers; null for MULTI_TEACHER
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation("LessonTeachers", fields: [teacherId], references: [id])
  class     Class?   @relation("LessonTeacherClass", fields: [classId], references: [id])

  @@id([lessonId, teacherId])
}

model Schedule {
  id        String        @id @default(uuid())
  name      String
  state     ScheduleState @default(DRAFT)
  isStarred Boolean       @default(false)
  entries   ScheduleEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ScheduleEntry {
  id         String     @id @default(uuid())
  scheduleId String
  schedule   Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson     @relation(fields: [lessonId], references: [id])
  day        Day
  slot       Int        // 1–slotsPerDay
  roomId     String?
  room       Room?      @relation("EntryRoom1", fields: [roomId],  references: [id])
  // Second room — only used by PARALLEL lessons (one room per class-teacher pair)
  roomId2    String?
  room2      Room?      @relation("EntryRoom2", fields: [roomId2], references: [id])
  // isSeeded: entry was fixed before auto-scheduler ran — AS will not move it
  isSeeded   Boolean    @default(false)
  overrides  Override[]
  createdAt  DateTime   @default(now())

  // A lesson can only appear once per (day, slot) within a schedule
  @@unique([scheduleId, lessonId, day, slot])
}

model Override {
  id              String        @id @default(uuid())
  entryId         String
  entry           ScheduleEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  // Stored as plain String so both HardInvariantType and RestrictionType values are accepted
  restrictionType String
  // The specific restriction record, if the violation came from a user-configured restriction
  // null for hard invariant (D-category) overrides
  restrictionId   String?
  note            String?
  createdAt       DateTime      @default(now())
}

model Restriction {
  id        String          @id @default(uuid())
  type      RestrictionType
  tier      RestrictionTier
  // Scope — which entity this restriction applies to
  // At least one should be set for non-structural restrictions
  teacherId String?
  teacher   Teacher?        @relation(fields: [teacherId], references: [id])
  classId   String?
  class     Class?          @relation(fields: [classId], references: [id])
  gradeId   String?
  grade     Grade?          @relation(fields: [gradeId], references: [id])
  lessonId  String?
  lesson    Lesson?         @relation(fields: [lessonId], references: [id])
  subjectId String?
  subject   Subject?        @relation(fields: [subjectId], references: [id])
  // Type-specific parameters (shape documented in shared/src/entities.ts RestrictionParams)
  params    Json            @default("{}")
  note      String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
}
